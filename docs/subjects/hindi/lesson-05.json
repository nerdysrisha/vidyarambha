  "title": "मात्रा: ि ी (Matra – \"i\" and \"ee\" signs)",
  "blocks": [
    {
      "sections": [
        {
          "type": "letters",
          "heading": "Two more matras: ि makes a short \"i\" and ी makes a long \"ee\". क + ि = कि (ki), क + ी = की (kee). Careful: ि is written before the letter, but we say it after.",
          "note": "Tap a big letter to hear it. Trace the light letters.",
          "items": [
            {
              "l": "कि",
              "w": "क + ि",
              "m": "ki"
            },
            {
              "l": "की",
              "w": "क + ी",
              "m": "kee"
            },
            {
              "l": "मि",
              "w": "म + ि",
              "m": "mi"
            },
            {
              "l": "मी",
              "w": "म + ी",
              "m": "mee"
            },
            {
              "l": "नि",
              "w": "न + ि",
              "m": "ni"
            },
            {
              "l": "नी",
